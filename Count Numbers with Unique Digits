# Problem Statement

Given an integer n, return the count of all numbers with unique digits, x, where 0 <= x < 10n.

Example 1:

Input: n = 2
Output: 91
Explanation: The answer should be the total numbers in the range of 0 ≤ x < 100, excluding 11,22,33,44,55,66,77,88,99
Example 2:

Input: n = 0
Output: 1
 
Constraints:

0 <= n <= 8

# Pattern observed

n=0;
O/p - 1

n = 1;
O/p - 1 + 9

n = 2
O/p - 91 = 10 + 9 * 9

n = 3
O/p -  91 + 9 * 9 * 8 =739

n=4
O/p - 739 + 9 * 9 * 8 * 7 = 5275

# Code

class Solution {
    public int countNumbersWithUniqueDigits(int n) {
        if(n == 0)
            return 1;
        int dp[] = new int[n+1];
        dp[0] = 1;
        for(int i=1;i<=n;i++)
        {   
            int k = 9;
            int temp = 9;
            for(int j=0;j<i-1;j++)
            {
                temp = temp * k;
                k--;
            }
            dp[i] = temp + dp[i - 1];
        }
        return dp[n];
    }
}
